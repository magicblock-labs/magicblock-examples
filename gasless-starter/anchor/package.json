{
  "scripts": {
    "lint:fix": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier --config ../../.prettierrc.json --ignore-path ../../.prettierignore --no-error-on-unmatched-pattern */*.js \"*/**/*{.js,.ts}\" --check",
    "build": "anchor build --ignore-keys",
    "test": "cargo +stable test --manifest-path tests-magicsvm-rs/Cargo.toml",
    "create-jar": "tsx scripts/create-jar.ts",
    "copy-idl": "cp target/idl/tip_jar.json app/src/idl/tip_jar.json && cp target/types/tip_jar.ts app/src/idl/tip_jar.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.18.0",
    "@solana/spl-token": "^0.4.14"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "prettier": "^3.5.3",
    "tsx": "^4.22.0",
    "typescript": "^5.8.3"
  },
